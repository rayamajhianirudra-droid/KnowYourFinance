# Maven build output - regenerated every build, never commit it
target/

# IDE-specific files - everyone's editor setup differs, keep it out of the repo
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS junk
.DS_Store

# Logs
*.log

# The local H2 database file (see build-log 12). This is YOUR data -
# every developer running the app locally gets their own, and it
# should never be committed or shared through git.
/data/
