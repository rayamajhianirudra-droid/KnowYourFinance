# Copy this file to .env. Never commit .env (it is in .gitignore).
#
# Default: a local PostgreSQL container. These values are for your own
# computer only, so any password works. Change it if you like.
POSTGRES_DB=kyf
POSTGRES_USER=kyf
POSTGRES_PASSWORD=change-me-local

# Optional: the address the app opens at. The default is port 3000, so the
# app opens at http://localhost:3000. If another program on your computer
# already uses 3000, remove the leading # and pick a free port, for example
# 3001, then open http://localhost:3001 instead.
# KYF_PORT=3001

# Optional: use the hosted Supabase database instead. Remove the leading #
# from the three lines and fill them in. Leave them commented to use the
# local database above.
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-pooler-host:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
# SPRING_DATASOURCE_PASSWORD=

# Optional: email for the "verify your email" message. With Docker, verification
# emails are caught by a local Mailpit container so nothing real is sent - read
# them (and the link) at http://localhost:8025. Change that port with
# KYF_MAILPIT_PORT. The emailed link points at KYF_APP_URL, which must be the
# address you open the app at; it defaults to http://localhost:<KYF_PORT>. For
# real email in production, point SPRING_MAIL_* at your own SMTP server instead.
# KYF_MAILPIT_PORT=8025
# KYF_APP_URL=http://localhost:3000
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_AUTH=true
# SPRING_MAIL_STARTTLS=true
# SPRING_MAIL_USERNAME=your-smtp-username
# SPRING_MAIL_PASSWORD=your-smtp-password
# KYF_MAIL_FROM=no-reply@yourdomain.com
